# LOCAL HACKATHON DEMO ONLY. Copy to .env. NEVER put real provider credentials here.
DEMO_MODE=true
ALLOW_REAL_PAYMENTS=false
PAYMENT_PROVIDER=mock
DATABASE_URL=postgresql+psycopg://fintech_demo:fintech_demo_local_only@127.0.0.1:5434/insurance_payment_demo
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
# Empty uses the frontend's same-origin proxy (also works on LAN).
NEXT_PUBLIC_API_BASE_URL=
API_PROXY_TARGET=http://127.0.0.1:8000
FRONTEND_EXTRA_ORIGINS=
# Replace these development placeholders locally before starting API; never commit your .env.
APP_SESSION_SECRET=REPLACE_WITH_RANDOM_LOCAL_DEV_SECRET
MOCK_WEBHOOK_SECRET=REPLACE_WITH_ANOTHER_RANDOM_LOCAL_DEV_SECRET
DEMO_OPERATOR_CODE=REPLACE_WITH_OPERATOR_LOCAL_DEV_CODE
FX_RATE_SOURCE=DEMO_FIXED
FX_DEMO_VND_PER_CNY=3500
FX_DEMO_VARIABLE_FEE_PERCENT=1.5
FX_DEMO_FIXED_FEE_VND=5000
FX_QUOTE_TTL_SECONDS=600
# OPTIONAL FUTURE SANDBOX ONLY (not required for P0)
AIRWALLEX_ENABLED=false
AIRWALLEX_API_BASE=https://api.sandbox.airwallex.com
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=

# MVP accounts: localhost defaults; set COOKIE_SECURE=true when served over HTTPS.
COOKIE_SECURE=false
SESSION_HOURS=24
# User-entered invoices use Frankfurter reference rates; sandbox fixtures retain DEMO_FIXED.
FX_REFERENCE_CACHE_HOURS=6
FX_REFERENCE_MAX_AGE_DAYS=7
# Application service fees only. No payment-provider fee is invented or included.
SERVICE_FEE_PERCENT=0
SERVICE_FIXED_FEE_VND=0

# Required for self-service SUCCESS/DECLINED methods. MANUAL keeps operator-driven tests.
PROVIDER_WORKER_ENABLED=true

# Cloud free demo uses one OCR process to reduce peak RAM; local default is two.
OCR_MAX_WORKERS=2

# Optional Gemini chatbot. Server-side only; never prefix with NEXT_PUBLIC_.
# Set these locally or in hosting secrets. Empty key keeps direct lookup usable.
GEMINI_ENABLED=false
GEMINI_DATA_MODE=DEMO_ONLY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=25

# Optional server-only provisioning; leave empty unless creating a dedicated RAG admin.
# Existing regular accounts are never promoted and existing passwords are never reset.
RAG_ADMIN_EMAIL=
RAG_ADMIN_PASSWORD=
