      "CreateText": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Title"
          },
          "publisher": {
            "type": "string",
            "maxLength": 200,
            "minLength": 2,
            "title": "Publisher"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "TEST_FIXTURE",
              "PUBLIC_REFERENCE"
            ],
            "title": "Source Kind",
            "default": "TEST_FIXTURE"
          },
          "license_note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 10,
            "title": "License Note"
          },
          "category": {
            "type": "string",
            "enum": [
              "POLICY",
              "CLAIMS",
              "GLOSSARY"
            ],
            "title": "Category",
            "default": "POLICY"
          },
          "language": {
            "type": "string",
            "enum": [
              "vi",
              "en",
              "zh"
            ],
            "title": "Language",
            "default": "vi"
          },
