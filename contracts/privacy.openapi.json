  "components": {
    "schemas": {
      "AssistantInput": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 500,
            "minLength": 2,
            "title": "Message"
          },
          "use_gemini": {
            "type": "boolean",
            "title": "Use Gemini",
            "default": false
          },
          "language": {
            "type": "string",
            "enum": [
              "vi",
              "en",
              "zh"
            ],
            "title": "Language",
            "default": "vi"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatTurn"
            },
            "type": "array",
            "maxItems": 6,
            "title": "History"
          },
          "privacy_revision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Privacy Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "AssistantInput"
      },
      "ChatTurn": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatTurn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PermissionInput": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Revision"
          },
          "notice_version": {
            "type": "string",
            "title": "Notice Version"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "scopes": {
            "items": {
              "type": "string",
              "enum": [
                "history",
                "documents",
                "finance",
                "insurance"
              ]
            },
            "type": "array",
            "maxItems": 4,
            "title": "Scopes"
          },
          "acknowledged": {
            "type": "boolean",
            "title": "Acknowledged",
            "default": false
          },
          "adult_confirmed": {
            "type": "boolean",
            "title": "Adult Confirmed",
            "default": false
          },
          "non_sensitive_confirmed": {
            "type": "boolean",
            "title": "Non Sensitive Confirmed",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision",
          "notice_version",
          "enabled"
        ],
        "title": "PermissionInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "APIKeyCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "baoan_session"
      }
    }
  }
}
