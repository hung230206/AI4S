  "components": {
    "schemas": {
      "AssistantInput": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 500,
            "minLength": 2,
            "title": "Message"
          },
          "use_gemini": {
            "type": "boolean",
            "title": "Use Gemini",
            "default": false
          },
          "language": {
            "type": "string",
            "enum": [
              "vi",
              "en",
              "zh"
            ],
            "title": "Language",
            "default": "vi"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatTurn"
            },
            "type": "array",
            "maxItems": 6,
            "title": "History"
          },
          "privacy_revision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Privacy Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "AssistantInput"
      },
      "Body_upload_api_v1_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "default": ""
          },
          "source_url": {
            "type": "string",
            "title": "Source Url",
            "default": ""
          },
          "language": {
            "type": "string",
            "enum": [
              "auto",
              "en",
              "vi",
              "zh"
            ],
            "title": "Language",
            "default": "auto"
          },
          "document_kind": {
            "type": "string",
            "enum": [
              "USER_PROVIDED",
              "PUBLIC_REFERENCE",
              "TEST_FIXTURE"
            ],
            "title": "Document Kind",
            "default": "USER_PROVIDED"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_v1_documents_post"
      },
      "Body_upload_api_v1_invoice_imports_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "language": {
            "type": "string",
            "enum": [
              "auto",
              "en",
              "vi",
              "zh"
            ],
            "title": "Language",
            "default": "auto"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_v1_invoice_imports_post"
      },
      "Body_upload_attachment_api_v1_insurance_claims__claim_id__attachments_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "item_code": {
            "type": "string",
            "title": "Item Code"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          }
        },
        "type": "object",
        "required": [
          "file",
          "item_code",
          "revision"
        ],
        "title": "Body_upload_attachment_api_v1_insurance_claims__claim_id__attachments_post"
      },
      "ChatTurn": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatTurn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PermissionInput": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Revision"
          },
          "notice_version": {
            "type": "string",
            "title": "Notice Version"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "preset": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "QUESTION_ONLY",
                  "SAMPLE_ASSISTANT",
                  "ACCOUNT_ASSISTANT"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Preset"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision",
          "notice_version",
          "enabled"
        ],
        "title": "PermissionInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
